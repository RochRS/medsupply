{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:migrate": "drizzle-kit push && node dist/index.js",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:setup": "drizzle-kit push && tsx src/database/seed/seed.ts",
    "db:seed": "tsx src/database/seed/seed.ts",
    "db:seed:categories": "tsx src/database/seed/seed-categories.ts",
    "db:seed:items": "tsx src/database/seed/seed-items.ts",
    "db:seed:suppliers": "tsx src/database/seed/seed-suppliers.ts",
    "db:seed:departments": "tsx src/database/seed/seed-departments.ts",
    "db:seed:users": "tsx src/database/seed/seed-users.ts",
    "db:seed:auth-user": "tsx src/database/seed/seed-auth-user.ts",
    "db:seed:auth-user:deploy": "drizzle-kit push && tsx src/database/seed/seed-auth-user.ts",
    "db:reset-admin": "tsx src/database/seed/reset-admin.ts",
    "db:reset-admin:deploy": "drizzle-kit push && tsx src/database/seed/reset-admin.ts",
    "db:seed:roles": "tsx src/database/seed/seed-roles.ts",
    "db:seed:request-descriptions": "tsx src/database/seed/seed-request-descriptions.ts",
    "db:seed:shipments": "tsx src/database/seed/seed-shipments.ts",
    "db:seed:requests": "tsx src/database/seed/seed-requests.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.27",
    "pg": "^8.22.0",
    "tsx": "^4.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  }
}
