{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext", // <-- Add this so TypeScript knows how to resolve your imports/exports
    "isolatedModules": true, // <-- Add this to fix the ts-jest hybrid module warning/error
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "../api/dist"
  },
  "exclude": ["node_modules"]
}
