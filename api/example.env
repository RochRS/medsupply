SERVER_PORT=5000

DATABASE_URL=postgresql://name:password@localhost:5432/medsupply

# Long random string in real .env (never commit the real secret)
BETTER_AUTH_SECRET=dev-secret-change-me

# App origin — better-auth serves under /api/auth by default
BETTER_AUTH_URL=http://localhost:5000

# Frontend origin for CORS + better-auth trustedOrigins
FRONTEND_URL=http://localhost:5173

DATABASE_TYPE=postgresql
